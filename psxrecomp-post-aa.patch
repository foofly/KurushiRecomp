+extern "C" int psx_mod_set_post_aa(uint32_t mode) {
+    if (mode > GL_POST_AA_FXAA_HQ) {
+        std::fprintf(stderr, "psxrecomp: mod rejected post-AA mode %u\n",
+                     (unsigned)mode);
+        return 0;
+    }
+    g_video_post_aa = (int)mode;
+    return 1;
+}
