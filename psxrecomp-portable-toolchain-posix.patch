diff --git a/host/psxrecomp_codegen_host.c b/host/psxrecomp_codegen_host.c
index dec25b94..c88b0c22 100644
--- a/host/psxrecomp_codegen_host.c
+++ b/host/psxrecomp_codegen_host.c
@@ -803,2 +803,2 @@ static void activate_toolchain_path(void) {
-    /* A cached portable pack must not shadow Linux/macOS native tools. */
