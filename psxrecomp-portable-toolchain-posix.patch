+    /* Callers prefer a complete native toolchain first. Activate the cached
+     * pack only when they fall back to portable tools. */
@@ -2011,0 +2012,2 @@ static const char* toolchain_zip_asset_name(void) {
+#elif defined(__aarch64__)
+    return NULL;
@@ -3236,0 +3239,9 @@ static int host_system_compiler_ready(void) {
+static int host_require_system_compiler(char* err_msg, size_t err_cap) {
+    if (host_system_compiler_ready())
+        return 1;
+    snprintf(err_msg, err_cap,
+             "Apple's Command Line Tools are required to build the game. "
+             "Open Terminal, run: xcode-select --install, then reopen this app.");
+    return 0;
+}
+
@@ -3415,3 +3426,2 @@ static int host_toolchain_is_ready(void) {
-#if !defined(_WIN32)
-    return host_system_toolchain_ready();
-#endif
+    if (host_system_toolchain_ready())
+        return 1;
@@ -3439,0 +3450,5 @@ static int host_toolchain_is_ready(void) {
+#endif
+#if defined(__aarch64__) && !defined(__APPLE__)
+    snprintf(g_tc_repair_note, sizeof(g_tc_repair_note),
+             "No portable build toolchain is published for Linux ARM64. "
+             "Install CMake, Ninja, Python 3 and C/C++ compilers.");
@@ -3627,4 +3641,0 @@ static int host_ensure_toolchain_with_progress(
-    snprintf(err_msg, err_cap,
-             "Native build tools are missing. Install CMake, Ninja, Python 3, "
-             "and C/C++ compilers with your package manager, then check tools again.");
-    return 0;
@@ -3635 +3646 @@ static int host_ensure_toolchain_with_progress(
-        return 1;
+        return host_require_system_compiler(err_msg, err_cap);
@@ -3644 +3655 @@ static int host_ensure_toolchain_with_progress(
-            if (host_portable_cmake_ready())
+            if (host_portable_cmake_ready() && host_system_compiler_ready())
@@ -3661 +3672 @@ static int host_ensure_toolchain_with_progress(
-        return 1;
+        return host_require_system_compiler(err_msg, err_cap);
@@ -3669 +3680 @@ static int host_ensure_toolchain_with_progress(
-                return 1;
+                return host_require_system_compiler(err_msg, err_cap);
@@ -3683,0 +3695,5 @@ static int host_ensure_toolchain_with_progress(
+        if (!toolchain_zip_asset_name()) {
+            snprintf(err_msg, err_cap,
+                     "No portable build toolchain is published for this platform.");
+            return 0;
+        }
@@ -3692 +3708 @@ static int host_ensure_toolchain_with_progress(
-                return 1;
+                return host_require_system_compiler(err_msg, err_cap);
diff --git a/tools/toolchain_pack.py b/tools/toolchain_pack.py
index 1d08d6e1..45d349b3 100644
--- a/tools/toolchain_pack.py
+++ b/tools/toolchain_pack.py
@@ -46,0 +47,2 @@ def host_artifact() -> str:
+    if platform.machine().lower() in ("aarch64", "arm64"):
+        return "linux-arm64"
@@ -960,2 +962,2 @@ def ensure_toolchain(
-        # Setup/rebuild on Linux and macOS uses native tools. Do not turn a
-        # missing dependency into an unsolicited portable-pack download.
+        # Prefer a complete native toolchain. When it is incomplete, continue
+        # below so a cached pack can be used or --download can fetch one.
@@ -976,6 +978,5 @@ def ensure_toolchain(
-            raise RuntimeError("Native build tools are missing or unusable: {}. Install CMake, "
-                               "Ninja, Python 3 and C/C++ compilers with your package manager."
-                               .format("/".join(names)))
-        if log:
-            log("Using native build tools on PATH")
-        return Path(resolved[0]).parent
+            break
+        else:
+            if log:
+                log("Using native build tools on PATH")
+            return Path(resolved[0]).parent
@@ -1039,0 +1041,8 @@ def ensure_toolchain(
+    if host_artifact() == "linux-arm64":
+        raise RuntimeError("No portable toolchain is published for Linux ARM64. "
+                           "Install CMake, Ninja, Python 3 and C/C++ compilers.")
+    if not download:
+        raise RuntimeError("Native build tools are missing or unusable and no cached "
+                           "portable toolchain was found. Install CMake, Ninja, Python 3 "
+                           "and C/C++ compilers, or retry with --download.")
+
